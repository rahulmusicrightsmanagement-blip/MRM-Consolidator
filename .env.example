# Copy to .env and edit:  cp .env.example .env
# Every value is optional for a local Docker run; set them when putting MRM-Consolidator on a server.

# Required: the PostgreSQL connection string. Quote it (URLs may contain '&').
MRM_DATABASE_URL='postgresql://user:password@host:5432/dbname'

# Google Drive for uploaded spreadsheets – written by `manage.py drive_setup` (see README); leave out to keep
# files only on this computer's disk.
# MRM_GDRIVE_CLIENT_ID=
# MRM_GDRIVE_CLIENT_SECRET=
# MRM_GDRIVE_REFRESH_TOKEN=
# MRM_GDRIVE_FOLDER_ID=

# Port on this machine the app is reachable at.
MRM_PORT=8010

# Hostnames / IPs people type in the browser (comma separated).
MRM_ALLOWED_HOSTS=localhost,127.0.0.1

# Full addresses incl. http(s)://, needed when the app sits behind a domain or proxy.
# MRM_CSRF_TRUSTED_ORIGINS=https://mrm.example.com

# Set to 1 once the site is served over HTTPS (secure cookies).
# MRM_HTTPS=1

# The only account that can add users. Its password is set from MRM_SUPER_ADMIN_PASSWORD on the
# first start (remove it from .env afterwards), or later with:
#   docker compose exec mrm python manage.py superadmin --reset
# MRM_SUPER_ADMIN_EMAIL=rahuljadhav0417@gmail.com
# MRM_SUPER_ADMIN_PASSWORD=

# Long random secret. If left empty one is generated and kept in the data volume.
# MRM_SECRET_KEY=

# Server tuning.
# MRM_WORKERS=3
# MRM_TIMEOUT=300
# MRM_LOG_LEVEL=INFO
